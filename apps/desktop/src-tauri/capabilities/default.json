{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "vscode://**" },
        { "url": "vscode-insiders://**" },
        { "url": "cursor://**" },
        { "url": "windsurf://**" },
        { "url": "jetbrains://**" },
        { "url": "subl://**" }
      ]
    }
  ]
}
